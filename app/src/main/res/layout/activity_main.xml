<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <!-- CABECERA DE LA APP -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="VishGuard AI"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/btnSettings"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="⚙"
        android:textColor="#90A4AE"
        android:textSize="20sp"
        android:background="#15FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Protección contra vishing en tiempo real"
        android:textColor="#607D8B"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ESPACIO DE AIRE PARA EL OVERLAY (Espacio libre reservado arriba) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTopOverlayArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.22" />

    <!-- CONTENEDOR CENTRAL: HALO RADIAL + HAZ DE LUZ + BOTÓN (Centrado hacia abajo) -->
    <FrameLayout
        android:id="@+id/containerPulse"
        android:layout_width="250dp"
        android:layout_height="250dp"
        app:layout_constraintTop_toBottomOf="@id/guidelineTopOverlayArea"
        app:layout_constraintBottom_toTopOf="@id/layoutStatusIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <View
            android:id="@+id/viewGlowRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_shield_button_glow"
            android:visibility="invisible" />

        <View
            android:id="@+id/viewOrbitLight"
            android:layout_width="214dp"
            android:layout_height="214dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_orbit_spinner"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/btnToggleService"
            android:layout_width="195dp"
            android:layout_height="195dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_shield_button"
            android:elevation="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvShieldIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️"
                android:textSize="42sp" />

            <TextView
                android:id="@+id/tvBtnAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ACTIVAR"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvBtnSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROTECCIÓN"
                android:textColor="#90CAF9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </LinearLayout>
    </FrameLayout>

    <!-- ESTADO CON PUNTO DE PULSO ACTIVO -->
    <LinearLayout
        android:id="@+id/layoutStatusIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/layoutMetricsCards"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/viewStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#546E7A"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvStatusInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado: Inactivo"
            android:textColor="#546E7A"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 📊 TARJETAS DE MÉTRICAS RÁPIDAS (2 COLUMNAS) -->
    <LinearLayout
        android:id="@+id/layoutMetricsCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toTopOf="@id/cardBottomOptions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TARJETA 1: AUDITORÍA DE LLAMADAS -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#111A2B"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞 Análisis de hoy"
                    android:textColor="#90A4AE"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalCallsMetric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0 análisis"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvThreatsBlockedMetric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0 amenazas"
                    android:textColor="#81C784"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA 2: ESTADO DEL MOTOR IA -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#111A2B"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Motor de IA"
                    android:textColor="#90A4AE"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEngineNameMetric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Gemini Flash"
                    android:textColor="#64B5F6"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEngineLatencyMetric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="En Línea • Semántico"
                    android:textColor="#4CAF50"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- BARRA INFERIOR DE OPCIONES -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBottomOptions"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#131B2A"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="18sp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Opciones y Registro de Llamadas"
                android:textColor="#ECEFF1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☰"
                android:textColor="#0288D1"
                android:textSize="20sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
