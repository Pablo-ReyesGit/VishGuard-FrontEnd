<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#162238"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Simular Transcripción de Llamada"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escribe la frase que simulará la llamada activa para probar el detector en tiempo real:"
        android:textColor="#90A4AE"
        android:textSize="13sp"
        android:layout_marginBottom="14dp" />

    <EditText
        android:id="@+id/etDialogFrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:gravity="top|start"
        android:hint="Ej: Hablamos de su banco, confirme su clave SMS..."
        android:textColorHint="#546E7A"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:background="#0D1424"
        android:padding="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnDialogCancelar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textColor="#90A4AE"
            android:backgroundTint="#00000000"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnDialogEnviar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANALIZAR CON IA"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#0288D1"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>